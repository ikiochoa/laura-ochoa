---
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.headline } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: 'story/', label: 'My story' },
  { href: 'garden/', label: 'Garden' },
  { href: 'bookshelf/', label: 'Bookshelf' },
  { href: 'projects/', label: 'Projects' },
  { href: 'hello/', label: 'Say hello' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title ? `${title} · ${profile.name}` : profile.name}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>{profile.name}</a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={base + item.href} aria-current={current.startsWith(base + item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Made in {profile.home}</span>
      <span class="links">
        <a href={profile.links.linkedin}>LinkedIn</a>
        <a href={profile.links.github}>GitHub</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  /* Structural styles only: the visual design comes in its own PR. */
  :root {
    --bg: #ffffff;
    --text: #1a1a2e;
    --muted: #55566b;
    --line: #e2e2ea;
    --accent: #e4572e;
    --surface: #f5f5fa;
    --max: 72rem;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12121c;
      --text: #f0f0f6;
      --muted: #a8a9bd;
      --line: #2c2c3c;
      --accent: #ff7a52;
      --surface: #1c1c2a;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.6;
  }
  a { color: var(--accent); }
  main { max-width: var(--max); margin: 0 auto; padding: 0 1rem 4rem; }
  h1, h2, h3 { line-height: 1.15; }
  .muted { color: var(--muted); }
  .eyebrow { color: var(--accent); font-weight: 600; font-size: 0.9rem; margin: 0; }
</style>

<style>
  .site-header {
    max-width: var(--max);
    margin: 0 auto;
    padding: 1.5rem 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
  }
  .wordmark { font-weight: 700; color: var(--text); text-decoration: none; font-size: 1.15rem; }
  nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  nav a { color: var(--text); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--accent); text-decoration: underline; text-underline-offset: 0.3em; }
  .site-footer {
    max-width: var(--max);
    margin: 0 auto;
    padding: 2rem 1rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .links { display: flex; gap: 1rem; }
</style>
