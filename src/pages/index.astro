---
import Base from '../layouts/Base.astro';
import NoteGrid from '../components/NoteGrid.astro';
import { profile, chapters } from '../data/profile';
import { getNotes } from '../data/notes';

const base = import.meta.env.BASE_URL;
const notes = (await getNotes()).slice(0, 6);
---
<Base>
  <section class="hero">
    <div class="me">
      <p class="eyebrow">{profile.greeting}</p>
      <h1>I'm Laura. {profile.headline}</h1>
      <p class="intro">{profile.intro}</p>
      <p class="actions">
        <a class="button" href={`${base}story/`}>Read my story</a>
        <a class="button secondary" href={`${base}garden/`}>Wander the garden</a>
      </p>
    </div>
    <figure class="photo">
      <div class="photo-placeholder">Photo of Laura</div>
    </figure>
  </section>

  <section>
    <h2>My story, so far</h2>
    <ol class="chapters">
      {chapters.map((chapter) => (
        <li>
          <a href={`${base}story/#chapter-${chapter.number.toLowerCase()}`}>
            <span class="eyebrow">Chapter {chapter.number.toLowerCase()}</span>
            <span class="chapter-title">{chapter.title}</span>
            <span class="muted">{chapter.period}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2>From the garden</h2>
    <p class="muted">Ideas, book notes and projects. Some are seeds, some are fully grown.</p>
    <NoteGrid notes={notes} empty="Nothing planted yet." />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 3rem;
    align-items: center;
    padding: 3rem 0;
  }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); margin: 0.5rem 0 1rem; }
  .intro { font-size: 1.2rem; color: var(--muted); max-width: 38rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .button {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .button.secondary { background: transparent; color: var(--text); border: 1.5px solid var(--text); }
  .photo { margin: 0; }
  .photo-placeholder {
    aspect-ratio: 4 / 5;
    max-width: 22rem;
    margin-inline: auto;
    border-radius: 1rem;
    background: var(--surface);
    border: 1px dashed var(--line);
    display: grid;
    place-items: center;
    color: var(--muted);
  }
  section { padding-top: 2.5rem; }
  .chapters {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1.5rem;
  }
  .chapters a { display: flex; flex-direction: column; gap: 0.25rem; color: var(--text); text-decoration: none; }
  .chapter-title { font-size: 1.15rem; font-weight: 600; }
</style>
