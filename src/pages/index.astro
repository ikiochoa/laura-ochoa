---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/laura.jpg';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import { profile, chapters } from '../data/profile';
import { getProjects, getThoughts, projectStages } from '../data/content';

const base = import.meta.env.BASE_URL;
const projects = await getProjects();
const thoughts = (await getThoughts()).slice(0, 3);
// The chapters cycle through the Mercado palette.
const chapterColors = ['pink', 'marigold', 'teal', 'purple', 'coral', 'text'];
---
<Base>
  <section class="hero">
    <div>
      <p class="greeting">{profile.greeting}</p>
      <h1>I'm Laura. {profile.headline}</h1>
      <p class="intro">{profile.intro}</p>
      <p class="actions">
        <a class="button" href={`${base}story/`}>Read my story</a>
        <a class="button secondary" href={`${base}projects/`}>See my projects</a>
      </p>
    </div>
    <figure class="photo">
      <Image src={photo} alt="Laura smiling on her road bike, high above the sea" widths={[480, 960]} sizes="(min-width: 48rem) 22rem, 90vw" loading="eager" />
    </figure>
  </section>

  <section data-accent="pink">
    <div class="section-head">
      <h2>My story, so far</h2>
      <a href={`${base}story/`}>Read it all</a>
    </div>
    <ol class="chapters">
      {chapters.map((chapter, i) => (
        <li style={`--chapter: var(--${chapterColors[i % chapterColors.length]})`}>
          <a href={`${base}story/#chapter-${chapter.number.toLowerCase()}`}>
            <span class="number">{String(i + 1).padStart(2, '0')}</span>
            <span class="chapter-title">{chapter.title}</span>
            <span class="muted">{chapter.period}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section data-accent="teal">
    <div class="section-head">
      <h2>My philosophy</h2>
      <a href={`${base}philosophy/`}>Explore</a>
    </div>
    <p class="muted">How I see the world, the books that shaped it, and the people I learn from.</p>
    <CardGrid count={thoughts.length} empty="The first thoughts are on their way.">
      {thoughts.map((t) => <Card href={`${base}philosophy/${t.id}/`} title={t.data.title} summary={t.data.summary} />)}
    </CardGrid>
  </section>

  <section data-accent="purple">
    <div class="section-head">
      <h2>Projects</h2>
      <a href={`${base}projects/`}>See all</a>
    </div>
    <p class="muted">Things I build, from first idea to done.</p>
    <CardGrid count={projects.length}>
      {projects.map((p) => (
        <Card href={`${base}projects/${p.id}/`} title={p.data.title} meta={projectStages[p.data.stage]} summary={p.data.summary} />
      ))}
    </CardGrid>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 3rem 4rem;
    align-items: center;
    padding: 3rem 0 4rem;
  }
  .greeting { margin: 0; font-weight: 700; color: var(--pink); }
  h1 { margin: 0.75rem 0 1.25rem; }
  .intro { font-size: 1.2rem; color: var(--muted); max-width: 36rem; margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .button {
    display: inline-block;
    padding: 0.85rem 1.4rem;
    background: var(--pink);
    color: var(--on-pink);
    text-decoration: none;
    font-weight: 700;
    border: 2px solid var(--pink);
  }
  .button:hover { background: var(--night); border-color: var(--night); }
  .button.secondary { background: transparent; color: var(--text); border-color: var(--text); }
  .button.secondary:hover { background: var(--text); color: var(--bg); }
  .photo { margin: 0 1.25rem 1.25rem 0; position: relative; max-width: 22rem; justify-self: center; width: calc(100% - 1.25rem); }
  .photo::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1.25rem -1.25rem 1.25rem;
    background: var(--marigold);
  }
  .photo img {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }
  section + section { padding-top: 3.5rem; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-top: 2px solid var(--text);
    padding-top: 1rem;
  }
  .section-head h2 { margin: 0; font-size: 2rem; }
  .section-head a { font-weight: 700; text-decoration: none; }
  .section-head a::after { content: ' →'; }
  .chapters {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 1rem;
  }
  .chapters a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1rem 0 0;
    border-top: 6px solid var(--chapter);
    color: var(--text);
    text-decoration: none;
  }
  .chapters a:hover .chapter-title { text-decoration: underline; text-decoration-color: var(--chapter); }
  .number { font-weight: 700; font-size: 0.85rem; color: var(--muted); }
  .chapter-title { font-family: var(--display); font-size: 1.15rem; font-weight: 700; line-height: 1.2; }
</style>
