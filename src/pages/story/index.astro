---
import Base from '../../layouts/Base.astro';
import StoryNav from '../../components/StoryNav.astro';
import { profile, chapters } from '../../data/profile';

const chapterColors = ['pink', 'marigold', 'teal', 'purple', 'coral', 'text'];
---
<Base title="My story" description="Laura Ochoa's story, told in chapters.">
  <StoryNav />
  <header class="page-intro">
    <h1>My story, so far</h1>
    <p class="muted">
      From {profile.places[0]} to {profile.home}, by way of {profile.places.slice(1, -1).join(' and ')}.
    </p>
  </header>

  {chapters.map((chapter, i) => (
    <section class="chapter prose" id={`chapter-${chapter.number.toLowerCase()}`} style={`--chapter: var(--${chapterColors[i % chapterColors.length]})`}>
      <p class="eyebrow">Chapter {chapter.number.toLowerCase()} · {chapter.period}</p>
      <h2>{chapter.title}</h2>
      <p>{chapter.summary}</p>
      {chapter.roles && (
        <ul class="roles">
          {chapter.roles.map((role) => (
            <li>
              <strong>{role.title}</strong>, {role.org}{role.period && <span class="muted"> ({role.period})</span>}
              {role.note && <p class="muted">{role.note}</p>}
            </li>
          ))}
        </ul>
      )}
      {chapter.loved && <p><strong>What I loved:</strong> {chapter.loved}</p>}
      {chapter.learned && <p><strong>What I learned:</strong> {chapter.learned}</p>}
      {chapter.link && <p><a href={import.meta.env.BASE_URL + chapter.link.href}>{chapter.link.label} →</a></p>}
    </section>
  ))}
</Base>

<style>
  .chapter { padding: 1.5rem 0 2.5rem; border-top: 6px solid var(--chapter); }
  .chapter .eyebrow { color: var(--text); }
  .chapter h2 { margin: 0.25rem 0 0.75rem; }
  .roles { padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .roles p { margin: 0.25rem 0 0; }
</style>
