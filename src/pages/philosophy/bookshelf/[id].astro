---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PhilosophyNav from '../../../components/PhilosophyNav.astro';
import { getBooks } from '../../../data/content';

export async function getStaticPaths() {
  const books = await getBooks();
  return books.map((book) => ({ params: { id: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
---
<Base title={book.data.title} description={`Laura's notes on ${book.data.title} by ${book.data.author}.`}>
  <PhilosophyNav />
  <article class="prose">
    <p class="eyebrow">Bookshelf</p>
    <h1>{book.data.title}</h1>
    <p class="muted">{book.data.author} · read {book.data.read}</p>
    <Content />
    {book.data.highlights.length > 0 && (
      <section>
        <h2>My highlights</h2>
        {book.data.highlights.map((h) => <blockquote>{h}</blockquote>)}
      </section>
    )}
  </article>
</Base>

<style>
  blockquote { margin: 1rem 0; padding-left: 1rem; border-left: 3px solid var(--accent); font-style: italic; }
</style>
