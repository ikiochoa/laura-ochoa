---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { stageLabel } from '../../data/notes';

export async function getStaticPaths() {
  const books = await getCollection('books', ({ data }) => !data.draft);
  return books.map((book) => ({ params: { id: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
---
<Base title={book.data.title} description={`Laura's notes on ${book.data.title} by ${book.data.author}.`}>
  <article>
    <p class="eyebrow">Book note · {stageLabel[book.data.stage]}</p>
    <h1>{book.data.title}</h1>
    <p class="muted">{book.data.author} · read {book.data.read}</p>
    {book.data.quote && <blockquote>“{book.data.quote}”</blockquote>}
    <Content />
  </article>
</Base>

<style>
  article { max-width: 44rem; padding: 2rem 0; }
  blockquote { margin: 1.5rem 0; padding-left: 1rem; border-left: 3px solid var(--accent); font-size: 1.3rem; font-style: italic; }
</style>
