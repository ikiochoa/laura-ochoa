---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ThoughtsNav from '../../components/ThoughtsNav.astro';
import { getThoughts } from '../../data/content';

export async function getStaticPaths() {
  const thoughts = await getThoughts();
  return thoughts.map((thought) => ({ params: { id: thought.id }, props: { thought } }));
}

const { thought } = Astro.props;
const { Content } = await render(thought);
---
<Base title={thought.data.title} description={thought.data.summary}>
  <ThoughtsNav />
  <article class="prose">
    <h1>{thought.data.title}</h1>
    <p class="muted">{thought.data.summary}</p>
    <Content />
  </article>
</Base>
