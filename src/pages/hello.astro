---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---
<Base title="Say hello" description="How to reach Laura Ochoa.">
  <section class="hello">
    <h1>Say hello</h1>
    <p>
      I'm based in {profile.home} and happy to talk about product, data, or a good book, in
      {profile.languages.filter((l) => !l.includes('learning')).join(', ')}.
    </p>
    <p>The easiest way to reach me is on <a href={profile.links.linkedin}>LinkedIn</a>.</p>
  </section>
</Base>

<style>
  .hello { max-width: 44rem; padding: 2rem 0; font-size: 1.15rem; }
</style>
