---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getProjects, projectStages } from '../../data/content';

const base = import.meta.env.BASE_URL;
const projects = await getProjects();
// Ideas get their own section; everything already being built sits together, in progress first.
const ideas = projects.filter((p) => p.data.stage === 'idea');
const built = projects
  .filter((p) => p.data.stage !== 'idea')
  .sort((a, b) => (a.data.stage === b.data.stage ? 0 : a.data.stage === 'in-progress' ? -1 : 1));
const sections = [
  { label: 'Ideas', items: ideas },
  { label: 'Built', items: built },
];
---
<Base title="Projects" description="Things Laura Ochoa builds, from first idea to done.">
  <header class="page-intro">
    <h1>Projects</h1>
    <p class="muted">Things I build, from a first idea to done.</p>
  </header>
  {sections.map(({ label, items }) => items.length > 0 && (
    <section class="stage">
      <h2>{label}</h2>
      <CardGrid count={items.length}>
        {items.map((p) => (
          <Card
            href={base + (p.data.page ?? `projects/${p.id}/`)}
            title={p.data.title}
            meta={p.data.stage === 'idea' ? undefined : projectStages[p.data.stage]}
            summary={p.data.summary}
            online={p.data.online}
          />
        ))}
      </CardGrid>
    </section>
  ))}
</Base>

<style>
  .stage { padding-bottom: 2rem; }
  .stage h2 { font-size: 1.4rem; border-top: 2px solid var(--text); padding-top: 0.75rem; }
</style>
