---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects, projectStages } from '../../data/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.title} description={project.data.summary}>
  <article class="prose">
    <p class="eyebrow">Project · {projectStages[project.data.stage]}</p>
    <h1>{project.data.title}</h1>
    <p class="muted">
      {project.data.summary}
      {project.data.builtWith && ` Built with ${project.data.builtWith}.`}
    </p>
    {project.data.url && <p><a href={project.data.url}>Visit {project.data.title}</a></p>}
    <Content />
  </article>
</Base>

<style>
  article { padding: 2rem 0; }
</style>
