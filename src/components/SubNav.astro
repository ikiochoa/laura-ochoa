---
// Tabs for the pages inside one section, like the parts of My story.
interface Props {
  label: string;
  items: { href: string; label: string }[];
}
const { label, items } = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.replace(/\/?$/, '/');
---
<nav class="subnav" aria-label={label}>
  {items.map((item) => (
    <a href={base + item.href} aria-current={current === base + item.href ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>

<style>
  .subnav { display: flex; flex-wrap: wrap; gap: 0; padding-top: 1.5rem; border-bottom: 1px solid var(--line); }
  .subnav a {
    padding: 0.6rem 1rem;
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
  }
  .subnav a:hover { color: var(--text); }
  .subnav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }
</style>
