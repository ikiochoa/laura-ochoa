---
// Simple, flat flags drawn with straight lines, so they look the same everywhere
// (emoji flags show up as two letters on Windows).
import type { CountryCode } from '../data/sabbatical';

interface Props {
  code: CountryCode;
  size?: string;
  title?: string;
}
const { code, size = '1.5rem', title } = Astro.props;
---
<svg class="flag" viewBox="0 0 30 20" style={`width: ${size}`} role="img" aria-label={title ?? code}>
  {title && <title>{title}</title>}
  {code === 'CH' && (
    <>
      <rect width="30" height="20" fill="#da291c" />
      <rect x="13" y="4" width="4" height="12" fill="#fff" />
      <rect x="9" y="8" width="12" height="4" fill="#fff" />
    </>
  )}
  {code === 'IT' && (
    <>
      <rect width="10" height="20" fill="#009246" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#ce2b37" />
    </>
  )}
  {code === 'FR' && (
    <>
      <rect width="10" height="20" fill="#002395" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#ed2939" />
    </>
  )}
  {code === 'ES' && (
    <>
      <rect width="30" height="20" fill="#aa151b" />
      <rect y="5" width="30" height="10" fill="#f1bf00" />
    </>
  )}
  {code === 'PT' && (
    <>
      <rect width="30" height="20" fill="#da291c" />
      <rect width="12" height="20" fill="#046a38" />
      <circle cx="12" cy="10" r="4" fill="#ffe900" />
    </>
  )}
  {code === 'AT' && (
    <>
      <rect width="30" height="20" fill="#c8102e" />
      <rect y="6.67" width="30" height="6.67" fill="#fff" />
    </>
  )}
  {code === 'DE' && (
    <>
      <rect width="30" height="6.67" fill="#000" />
      <rect y="6.67" width="30" height="6.67" fill="#dd0000" />
      <rect y="13.33" width="30" height="6.67" fill="#ffce00" />
    </>
  )}
  {code === 'CO' && (
    <>
      <rect width="30" height="10" fill="#fcd116" />
      <rect y="10" width="30" height="5" fill="#003893" />
      <rect y="15" width="30" height="5" fill="#ce1126" />
    </>
  )}
  {code === 'MX' && (
    <>
      <rect width="10" height="20" fill="#006847" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#ce1126" />
      <circle cx="15" cy="10" r="2.5" fill="#8c5a2b" />
    </>
  )}
  {code === 'US' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      {[0, 2, 4, 6, 8, 10, 12].map((i) => (
        <rect y={i * (20 / 13)} width="30" height={20 / 13} fill="#b22234" />
      ))}
      <rect width="12" height={(20 / 13) * 7} fill="#3c3b6e" />
    </>
  )}
</svg>

<style>
  .flag {
    display: inline-block;
    aspect-ratio: 3 / 2;
    height: auto;
    vertical-align: middle;
    box-shadow: 0 0 0 1px var(--line);
    flex-shrink: 0;
  }
</style>
