---
interface Props {
  href: string;
  title: string;
  meta?: string;
  summary?: string;
}
const { href, title, meta, summary } = Astro.props;
---
<a class="card" href={href}>
  {meta && <span class="meta">{meta}</span>}
  <span class="title">{title}</span>
  {summary && <span class="summary">{summary}</span>}
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-top: 4px solid var(--accent);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .meta { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  .title { font-family: var(--display); font-size: 1.3rem; font-weight: 700; line-height: 1.2; }
  .summary { color: var(--muted); }
</style>
